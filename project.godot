; Engine configuration file.
; Hand-authored; see godot-project-workflow notes in README.

config_version=5

[application]

config/name="My Samurai Way"
config/description="RPG de samurai em HD-2D: um vale, várias facções, muitos finais."
run/main_scene="res://scenes/title.tscn"
boot_splash/bg_color=Color(0.04, 0.02, 0.06, 1)
boot_splash/image="res://assets/ui/boot_splash.png"
boot_splash/fullsize=true
boot_splash/use_filter=true
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

